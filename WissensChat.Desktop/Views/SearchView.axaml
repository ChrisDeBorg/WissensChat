<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WissensChat.Desktop.ViewModels"
             xmlns:core="using:WissensChat.Core"
             x:Class="WissensChat.Desktop.Views.SearchView"
             x:DataType="vm:SearchViewModel">
  <DockPanel Margin="12">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <TextBox Text="{Binding Query}" Watermark="Semantische Suche …">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Column="1" Content="Suchen" Command="{Binding SearchCommand}" Margin="8,0,0,0" />
    </Grid>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,8,0,0" />
    <ListBox ItemsSource="{Binding Results}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="core:SearchHit">
          <StackPanel Margin="4" Spacing="4">
            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxLines="6" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
